# Canonical list of backend environment variables. Copy to .env and fill in.
# Never commit .env.
#
# Neon shows URLs as postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
# Convert: move USER and PASSWORD into their own variables, prefix with jdbc:, keep sslmode.

# Pooled host (contains -pooler). Used by the app.
DB_URL=jdbc:postgresql://<pooler-host>/<db>?sslmode=require&prepareThreshold=0
# Direct host (no -pooler). Used by Flyway only.
DB_MIGRATION_URL=jdbc:postgresql://<direct-host>/<db>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# JWT signing key (RS256). One RSA private key, PKCS#8, base64 on ONE line (no ----- lines).
# The public key is derived from it at startup. Generate once (Git Bash, in backend/):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-dev.pem
#   echo "JWT_PRIVATE_KEY=$(grep -v -- '-----' jwt-dev.pem | tr -d '\r\n')" >> .env
#   rm jwt-dev.pem
JWT_PRIVATE_KEY=
# Goes into the token header as "kid". Change it when you rotate the key.
JWT_KEY_ID=spendly-dev-1

# Groq (OpenAI-compatible). Used from the AI insights slice onward.
GROQ_API_KEY=

# S3-compatible object storage for attachments. Used from the attachments slice onward.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
